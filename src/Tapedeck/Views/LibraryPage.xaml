<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tapedeck.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Tapedeck.Controls"
    xmlns:m="using:Tapedeck.Models"
    Background="Transparent">

    <Grid>
        <ScrollViewer x:Name="Scroller">
            <StackPanel Padding="36,20,36,36">
                <TextBlock Text="Library" Style="{StaticResource PageTitleStyle}" />

                <Grid Margin="0,0,0,20" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <SelectorBar x:Name="Tabs" SelectionChanged="OnTabChanged">
                        <SelectorBarItem Text="Playlists" Tag="FEmusic_liked_playlists" IsSelected="True" />
                        <SelectorBarItem Text="Songs" Tag="FEmusic_liked_videos" />
                        <SelectorBarItem Text="Albums" Tag="FEmusic_liked_albums" />
                        <SelectorBarItem Text="Artists" Tag="FEmusic_library_corpus_track_artists" />
                        <SelectorBarItem Text="Subscriptions" Tag="FEmusic_library_corpus_artists" />
                        <SelectorBarItem Text="History" Tag="FEmusic_history" />
                    </SelectorBar>
                    <Button x:Name="PlayAllButton" Grid.Column="1" Style="{StaticResource PillAccentButtonStyle}" Visibility="Collapsed"
                            VerticalAlignment="Center" Click="OnPlayAll">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Play all" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsRepeater x:Name="ShelvesRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="m:Shelf">
                            <c:ShelfView Shelf="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="48" Height="48" />

        <StackPanel x:Name="SignInPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="14" MaxWidth="420">
            <FontIcon Glyph="&#xE8F1;" FontSize="40" />
            <TextBlock Text="Your library lives in your account" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" />
            <TextBlock Text="Sign in with your Google account to see your playlists, liked songs, albums and history."
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Sign in" HorizontalAlignment="Center" Style="{StaticResource PillAccentButtonStyle}" Click="OnSignIn" />
        </StackPanel>

        <StackPanel x:Name="MessagePanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="460">
            <FontIcon Glyph="&#xE8D6;" FontSize="36" />
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
