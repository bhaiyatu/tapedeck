<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Tapedeck.Views.ShelvesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Tapedeck.Controls"
    xmlns:m="using:Tapedeck.Models"
    Background="Transparent">

    <Grid>
        <ScrollViewer x:Name="Scroller" ViewChanged="OnScrollChanged">
            <StackPanel Padding="{StaticResource PagePadding}">
                <TextBlock x:Name="TitleText" Style="{StaticResource PageTitleStyle}" />

                <ScrollViewer x:Name="ChipsScroller" Margin="0,0,0,24" Visibility="Collapsed"
                              HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                    <ItemsRepeater x:Name="ChipsRepeater">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="m:Chip">
                                <ToggleButton Content="{x:Bind Text}" IsChecked="{x:Bind IsSelected}" Tag="{x:Bind}"
                                              Style="{StaticResource ChipToggleStyle}" Margin="0" Click="OnChipClick" />
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <ItemsRepeater x:Name="ShelvesRepeater">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="m:Shelf">
                            <c:ShelfView Shelf="{x:Bind}" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>

                <ProgressRing x:Name="MoreRing" IsActive="False" Width="28" Height="28" Margin="0,8" />
            </StackPanel>
        </ScrollViewer>

        <ProgressRing x:Name="LoadingRing" IsActive="False" Width="48" Height="48" />

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="12" MaxWidth="460">
            <FontIcon Glyph="&#xE783;" FontSize="36" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" TextAlignment="Center" />
            <Button Content="Try again" HorizontalAlignment="Center" Style="{StaticResource PillAccentButtonStyle}" Click="OnRetry" />
        </StackPanel>
    </Grid>
</Page>
