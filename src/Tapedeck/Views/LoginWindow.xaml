<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tapedeck.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Sign in to YouTube Music">

    <Grid x:Name="Root" Background="{ThemeResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Address bar: always shows which site is asking for your password. -->
        <Grid Padding="14,10,14,8" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border x:Name="AddressPill" CornerRadius="17" Padding="12,7" BorderThickness="1"
                    Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource SurfaceStroke}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon x:Name="LockIcon" Glyph="&#xE72E;" FontSize="13" />
                    <TextBlock x:Name="HostText" Text="Connecting…" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TrustText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextMuted}" />
                </StackPanel>
            </Border>
            <ProgressRing x:Name="LoadingRing" Grid.Column="1" IsActive="True" Width="18" Height="18" />
        </Grid>

        <InfoBar x:Name="Banner" Grid.Row="1" IsOpen="True" IsClosable="False" Severity="Informational" Margin="14,0,14,10" CornerRadius="12"
                 Title="Tapedeck never sees your password"
                 Message="You type it into Google's own page. Only the sign-in session is kept, on this PC, encrypted to your Windows account." />

        <InfoBar x:Name="BlockedBar" Grid.Row="1" IsOpen="False" IsClosable="False" Severity="Warning" Margin="14,0,14,10" CornerRadius="12"
                 Title="This page isn't Google">
            <InfoBar.ActionButton>
                <Button x:Name="AllowButton" Content="Continue to this site" Click="OnAllowSite" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Border Grid.Row="2" Margin="14,0,14,14" CornerRadius="16" BorderThickness="1"
                BorderBrush="{ThemeResource CanvasStroke}" Background="White">
            <WebView2 x:Name="Browser" />
        </Border>
    </Grid>
</Window>
