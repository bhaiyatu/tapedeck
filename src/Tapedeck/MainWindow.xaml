<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Tapedeck.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Tapedeck.Controls"
    xmlns:h="using:Tapedeck.Helpers"
    Title="Tapedeck">

    <Grid x:Name="Root" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="Right" Invoked="OnAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Left" Invoked="OnAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Up" Invoked="OnAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Down" Invoked="OnAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OnAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="S" Invoked="OnAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnAccelerator" />
        </Grid.KeyboardAccelerators>

        <!-- The hidden YouTube Music player. 1×1 and transparent, but "visible" to Chromium so it isn't throttled. -->
        <WebView2 x:Name="PlayerWebView" Grid.Row="0" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" IsTabStop="False"
                  HorizontalAlignment="Left" VerticalAlignment="Top" />

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="Tapedeck"
                  IsBackButtonVisible="True" IsPaneToggleButtonVisible="True"
                  BackRequested="OnBackRequested" PaneToggleRequested="OnPaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/Tapedeck.png" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search songs, albums, artists, podcasts"
                                QueryIcon="Find" MinWidth="320" MaxWidth="560" VerticalAlignment="Center"
                                TextChanged="OnSearchTextChanged" QuerySubmitted="OnSearchSubmitted"
                                AutomationProperties.Name="Search" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <Button x:Name="AccountButton" Background="Transparent" BorderThickness="0" Padding="4" Margin="0,0,8,0"
                        CornerRadius="16" ToolTipService.ToolTip="Account">
                    <PersonPicture Width="28" Height="28"
                                   ProfilePicture="{x:Bind h:Fmt.Img(Auth.Account.PhotoUrl), Mode=OneWay}"
                                   DisplayName="{x:Bind Auth.Account.Name, Mode=OneWay, FallbackValue=''}" />
                    <Button.Flyout>
                        <MenuFlyout x:Name="AccountMenu" Opening="OnAccountMenuOpening" />
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <NavigationView x:Name="NavView" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                            IsPaneToggleButtonVisible="False" IsSettingsVisible="True" OpenPaneLength="220"
                            SelectionChanged="OnNavSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="Home" Tag="home">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Explore" Tag="explore">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE7B3;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Library" Tag="library">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItemSeparator />
                    <NavigationViewItem Content="Liked music" Tag="liked">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xEB51;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Charts" Tag="charts">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="New releases" Tag="new">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem Content="Moods &amp; genres" Tag="moods">
                        <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Frame x:Name="ContentFrame" Navigated="OnFrameNavigated" />
            </NavigationView>

            <!-- Side panel: queue / lyrics -->
            <Grid x:Name="SidePanel" Grid.Column="1" Width="370" Visibility="Collapsed"
                  Background="{ThemeResource SidePanelBackground}"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="8,6,6,0">
                    <SelectorBar x:Name="PanelTabs" SelectionChanged="OnPanelTabChanged">
                        <SelectorBarItem x:Name="QueueTab" Text="Up next" Tag="queue" />
                        <SelectorBarItem x:Name="LyricsTab" Text="Lyrics" Tag="lyrics" />
                    </SelectorBar>
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE711;" FontSize="12" ToolTipService.ToolTip="Close panel" Click="OnClosePanel" />
                </Grid>
                <c:QueuePanel x:Name="QueueView" Grid.Row="1" />
                <c:LyricsPanel x:Name="LyricsView" Grid.Row="1" Visibility="Collapsed" />
            </Grid>
        </Grid>

        <c:PlayerBar x:Name="Bar" Grid.Row="2" />

        <!-- Transient status messages ("Added to queue", errors). -->
        <InfoBar x:Name="Toast" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Informational"
                 HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" MaxWidth="560" />

        <InfoBar x:Name="InterstitialBar" Grid.Row="1" IsOpen="False" IsClosable="True" Severity="Warning"
                 HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0" MaxWidth="640"
                 Title="Playback is waiting on YouTube"
                 Message="YouTube Music wants you to confirm something before it will play.">
            <InfoBar.ActionButton>
                <Button Content="Open" Click="OnOpenInterstitial" />
            </InfoBar.ActionButton>
        </InfoBar>
    </Grid>
</Window>
