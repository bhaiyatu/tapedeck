<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tapedeck.Controls.LyricsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Tapedeck.Controls"
    xmlns:h="using:Tapedeck.Helpers">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListView x:Name="LinesList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnLineClick"
                  Padding="12,8,12,120" Visibility="Collapsed">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="8,6" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="c:LyricLineView">
                    <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold"
                               Opacity="{x:Bind h:Fmt.ActiveOpacity(IsActive), Mode=OneWay}">
                        <TextBlock.OpacityTransition>
                            <ScalarTransition Duration="0:0:0.2" />
                        </TextBlock.OpacityTransition>
                    </TextBlock>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ScrollViewer x:Name="PlainScroller" Visibility="Collapsed" Padding="20,8,20,24">
            <TextBlock x:Name="PlainText" TextWrapping="Wrap" FontSize="16" LineHeight="26" IsTextSelectionEnabled="True" />
        </ScrollViewer>

        <StackPanel x:Name="StatusPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Padding="24">
            <ProgressRing x:Name="LoadingRing" IsActive="False" Width="28" Height="28" />
            <FontIcon x:Name="StatusIcon" Glyph="&#xE8D2;" FontSize="32" Opacity="0.6" />
            <TextBlock x:Name="StatusText" Text="Lyrics show up here while a song plays." TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource SecondaryTextStyle}" MaxLines="3" />
        </StackPanel>

        <TextBlock x:Name="SourceText" Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Margin="20,6,20,10" />
    </Grid>
</UserControl>
