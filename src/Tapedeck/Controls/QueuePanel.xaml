<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tapedeck.Controls.QueuePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Tapedeck.Controls"
    xmlns:m="using:Tapedeck.Models"
    xmlns:h="using:Tapedeck.Helpers">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ListViewItemBackgroundPointerOver" Color="Transparent" />
        <SolidColorBrush x:Key="ListViewItemBackgroundPressed" Color="Transparent" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="16,4,8,8">
            <TextBlock x:Name="CountText" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
            <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}" Content="&#xE74D;"
                    ToolTipService.ToolTip="Clear upcoming" Click="OnClear"
                    Visibility="{x:Bind Player.HasTrack, Mode=OneWay}" />
        </Grid>

        <ListView x:Name="QueueList" Grid.Row="1" ItemsSource="{x:Bind Player.Queue}" SelectionMode="None"
                  IsItemClickEnabled="True" ItemClick="OnItemClick"
                  CanReorderItems="True" CanDragItems="True" AllowDrop="True" Padding="8,0,8,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="m:MusicItem">
                    <c:TrackRow Item="{x:Bind}" HandlesTap="False" InQueue="True" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="EmptyPanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Padding="24"
                    Visibility="{x:Bind h:Fmt.Hide(Player.HasTrack), Mode=OneWay}">
            <FontIcon Glyph="&#xE90B;" FontSize="32" Opacity="0.6" />
            <TextBlock Text="Nothing queued" Style="{StaticResource BodyStrongTextBlockStyle}" HorizontalAlignment="Center" />
            <TextBlock Text="Play a song, album or playlist and what's coming up appears here." TextWrapping="Wrap" TextAlignment="Center"
                       Style="{StaticResource SecondaryTextStyle}" MaxLines="3" />
        </StackPanel>
    </Grid>
</UserControl>
