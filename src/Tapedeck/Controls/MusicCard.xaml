<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tapedeck.Controls.MusicCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:h="using:Tapedeck.Helpers"
    PointerEntered="OnPointerEntered"
    PointerExited="OnPointerExited"
    Tapped="OnTapped"
    RightTapped="OnRightTapped"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    KeyDown="OnKeyDown">

    <StackPanel x:Name="Root" Width="{x:Bind CardWidth, Mode=OneWay}" Spacing="8" Background="Transparent">
        <Grid x:Name="ArtHost"
              Height="{x:Bind ArtHeight, Mode=OneWay}"
              CornerRadius="{x:Bind h:Fmt.ArtRadius(Item.IsRound), Mode=OneWay}"
              Background="{ThemeResource ArtPlaceholder}">
            <FontIcon Glyph="&#xE8D6;" FontSize="32" Opacity="0.35" />
            <Image Source="{x:Bind h:Fmt.Img(Item.ThumbnailUrl), Mode=OneWay}" Stretch="UniformToFill" />
            <Grid x:Name="HoverOverlay" Background="{ThemeResource CardHoverOverlay}" Opacity="0">
                <Grid.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.12" />
                </Grid.OpacityTransition>
                <Button x:Name="PlayButton"
                        Style="{StaticResource BigPlayButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"
                        Content="&#xE768;"
                        ToolTipService.ToolTip="Play"
                        Visibility="{x:Bind CanPlay, Mode=OneWay}"
                        Click="OnPlayClick" />
            </Grid>
        </Grid>
        <StackPanel Spacing="2" HorizontalAlignment="{x:Bind TextAlignment, Mode=OneWay}">
            <TextBlock Text="{x:Bind Item.Title, Mode=OneWay}"
                       Style="{StaticResource BodyStrongTextBlockStyle}"
                       TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       TextAlignment="{x:Bind TextAlign, Mode=OneWay}" />
            <TextBlock Text="{x:Bind Item.Subtitle, Mode=OneWay}"
                       Style="{StaticResource SecondaryTextStyle}"
                       TextWrapping="Wrap" MaxLines="2"
                       TextAlignment="{x:Bind TextAlign, Mode=OneWay}" />
        </StackPanel>
    </StackPanel>
</UserControl>
