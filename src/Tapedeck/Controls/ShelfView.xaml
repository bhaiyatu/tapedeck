<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Tapedeck.Controls.ShelfView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:Tapedeck.Controls"
    xmlns:m="using:Tapedeck.Models"
    xmlns:h="using:Tapedeck.Helpers">

    <UserControl.Resources>
        <DataTemplate x:Key="CardTemplate" x:DataType="m:MusicItem">
            <c:MusicCard Item="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="RowTemplate" x:DataType="m:MusicItem">
            <c:TrackRow Item="{x:Bind}" />
        </DataTemplate>
        <DataTemplate x:Key="ChipTemplate" x:DataType="m:MusicItem">
            <Button Style="{StaticResource SoftButtonStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Left" Padding="16,0" CornerRadius="14"
                    Background="{ThemeResource SurfaceBackground}" BorderBrush="{ThemeResource SurfaceStroke}" BorderThickness="1"
                    Click="OnChipClick" Tag="{x:Bind}">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center"
                             Fill="{x:Bind h:Fmt.MoodBrush(AccentColor)}" Visibility="{x:Bind h:Fmt.ShowObj(AccentColor)}" />
                    <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextStrong}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="14" Margin="0,0,0,36">
        <Grid x:Name="Header" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom">
                <TextBlock x:Name="StraplineText" Style="{StaticResource SectionLabelStyle}" Margin="0,0,0,2" Visibility="Collapsed" />
                <TextBlock x:Name="TitleText" Style="{StaticResource ShelfTitleStyle}" />
            </StackPanel>
            <Button x:Name="MoreButton" Grid.Column="1" Content="See all" Style="{StaticResource PillButtonStyle}"
                    Padding="14,0" Height="30" CornerRadius="15" Visibility="Collapsed" Click="OnMoreClick" />
            <Button x:Name="LeftButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}" Content="&#xE76B;"
                    ToolTipService.ToolTip="Scroll left" Visibility="Collapsed" Click="OnScrollLeft" />
            <Button x:Name="RightButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Content="&#xE76C;"
                    ToolTipService.ToolTip="Scroll right" Visibility="Collapsed" Click="OnScrollRight" />
        </Grid>

        <!-- Cards: horizontal carousel. User scrolling is off so the mouse wheel keeps scrolling the page;
             the arrow buttons page through it instead. -->
        <ScrollViewer x:Name="Carousel" Visibility="Collapsed" Padding="0,5" Margin="0,-5"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"
                      ViewChanged="OnCarouselViewChanged" SizeChanged="OnCarouselSizeChanged">
            <ItemsRepeater x:Name="CardsRepeater" ItemTemplate="{StaticResource CardTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Orientation="Horizontal" Spacing="16" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>

        <ItemsRepeater x:Name="GridRepeater" Visibility="Collapsed" ItemTemplate="{StaticResource CardTemplate}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="168" MinColumnSpacing="16" MinRowSpacing="24" ItemsJustification="Start" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <ItemsRepeater x:Name="RowsRepeater" Visibility="Collapsed" ItemTemplate="{StaticResource RowTemplate}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="340" MinItemHeight="56" MinColumnSpacing="12" MinRowSpacing="2"
                                   ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <ItemsRepeater x:Name="ChipsRepeater" Visibility="Collapsed" ItemTemplate="{StaticResource ChipTemplate}">
            <ItemsRepeater.Layout>
                <UniformGridLayout MinItemWidth="190" MinItemHeight="48" MinColumnSpacing="12" MinRowSpacing="12"
                                   ItemsStretch="Fill" />
            </ItemsRepeater.Layout>
        </ItemsRepeater>

        <TextBlock x:Name="BodyText" Visibility="Collapsed" TextWrapping="Wrap" MaxLines="4" TextTrimming="WordEllipsis"
                   IsTextSelectionEnabled="True" Style="{StaticResource BodyTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" Tapped="OnBodyTapped" />
    </StackPanel>
</UserControl>
