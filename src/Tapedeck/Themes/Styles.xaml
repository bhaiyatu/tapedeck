<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="PlayerBarBackground" Color="#F2FFFFFF" />
            <SolidColorBrush x:Key="SidePanelBackground" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="CardHoverOverlay" Color="#33000000" />
            <SolidColorBrush x:Key="ArtPlaceholder" Color="#14000000" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="#66000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="PlayerBarBackground" Color="#E6202020" />
            <SolidColorBrush x:Key="SidePanelBackground" Color="#80202020" />
            <SolidColorBrush x:Key="CardHoverOverlay" Color="#55000000" />
            <SolidColorBrush x:Key="ArtPlaceholder" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="#66FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="PlayerBarBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SidePanelBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardHoverOverlay" Color="Transparent" />
            <SolidColorBrush x:Key="ArtPlaceholder" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="CardWidth">168</x:Double>
    <x:Double x:Key="WideCardWidth">284</x:Double>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleLargeTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="ShelfTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Borderless round icon button used across the player bar and headers. -->
    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="BigPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="PillAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="18,8" />
        <Setter Property="MinHeight" Value="36" />
    </Style>

    <Style x:Key="ChipToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
</ResourceDictionary>
