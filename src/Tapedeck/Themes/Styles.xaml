<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ───────────── Surfaces (easyui-style near-black, BoardUI-style light) ───────────── -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackground" Color="#0A0A0C" />
            <SolidColorBrush x:Key="CanvasBackground" Color="#111114" />
            <SolidColorBrush x:Key="CanvasStroke" Color="#1C1C21" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#17171B" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#1F1F25" />
            <SolidColorBrush x:Key="SurfaceStroke" Color="#26262D" />
            <SolidColorBrush x:Key="SubtleHover" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="SubtlePressed" Color="#0AFFFFFF" />
            <SolidColorBrush x:Key="TextStrong" Color="#F4F4F5" />
            <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA" />
            <SolidColorBrush x:Key="TextFaint" Color="#6B6B75" />
            <SolidColorBrush x:Key="InverseBackground" Color="#F4F4F5" />
            <SolidColorBrush x:Key="InverseText" Color="#0A0A0C" />
            <SolidColorBrush x:Key="ArtPlaceholder" Color="#1C1C21" />
            <SolidColorBrush x:Key="CardHoverOverlay" Color="#40000000" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="#5CFFFFFF" />
            <AcrylicBrush x:Key="PlayerGlass" TintColor="#141418" TintOpacity="0.72" TintLuminosityOpacity="0.85" FallbackColor="#17171B" />
            <SolidColorBrush x:Key="SegmentSelected" Color="#2C2C33" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackground" Color="#F2F2F4" />
            <SolidColorBrush x:Key="CanvasBackground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CanvasStroke" Color="#E6E6EA" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="#F4F4F6" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#ECECEF" />
            <SolidColorBrush x:Key="SurfaceStroke" Color="#E4E4E7" />
            <SolidColorBrush x:Key="SubtleHover" Color="#0D000000" />
            <SolidColorBrush x:Key="SubtlePressed" Color="#08000000" />
            <SolidColorBrush x:Key="TextStrong" Color="#0A0A0C" />
            <SolidColorBrush x:Key="TextMuted" Color="#5B5B66" />
            <SolidColorBrush x:Key="TextFaint" Color="#9A9AA4" />
            <SolidColorBrush x:Key="InverseBackground" Color="#0A0A0C" />
            <SolidColorBrush x:Key="InverseText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="ArtPlaceholder" Color="#ECECEF" />
            <SolidColorBrush x:Key="CardHoverOverlay" Color="#26000000" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="#59000000" />
            <AcrylicBrush x:Key="PlayerGlass" TintColor="#FFFFFF" TintOpacity="0.75" TintLuminosityOpacity="0.9" FallbackColor="#FFFFFF" />
            <SolidColorBrush x:Key="SegmentSelected" Color="#FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AppBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CanvasBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CanvasStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SurfaceBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SurfaceStroke" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SubtleHover" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="SubtlePressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="TextStrong" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextMuted" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextFaint" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="InverseBackground" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="InverseText" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="ArtPlaceholder" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardHoverOverlay" Color="Transparent" />
            <SolidColorBrush x:Key="LyricDimBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="PlayerGlass" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SegmentSelected" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- ───────────── Brand ───────────── -->
    <!-- Rose → fuchsia, after Kaset. Overriding the system accent restyles sliders, toggles, accent buttons. -->
    <Color x:Key="BrandRose">#FF2D55</Color>
    <Color x:Key="BrandFuchsia">#C026D3</Color>
    <Color x:Key="SystemAccentColor">#FF2D55</Color>
    <Color x:Key="SystemAccentColorLight1">#FF5577</Color>
    <Color x:Key="SystemAccentColorLight2">#FF6F8B</Color>
    <Color x:Key="SystemAccentColorLight3">#FF96AA</Color>
    <Color x:Key="SystemAccentColorDark1">#E11D48</Color>
    <Color x:Key="SystemAccentColorDark2">#BE123C</Color>
    <Color x:Key="SystemAccentColorDark3">#9F1239</Color>

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF2D55" Offset="0" />
        <GradientStop Color="#C026D3" Offset="1" />
    </LinearGradientBrush>

    <CornerRadius x:Key="CardRadius">12</CornerRadius>
    <x:Double x:Key="CardWidth">172</x:Double>
    <x:Double x:Key="WideCardWidth">288</x:Double>
    <!-- One horizontal inset for every page, so titles, chips, cards and rows share a left edge. -->
    <Thickness x:Key="PagePadding">32,8,32,40</Thickness>

    <!-- ───────────── Typography ───────────── -->
    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="34" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-25" />
        <Setter Property="Foreground" Value="{ThemeResource TextStrong}" />
        <Setter Property="Margin" Value="0,4,0,18" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>

    <Style x:Key="ShelfTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="-10" />
        <Setter Property="Foreground" Value="{ThemeResource TextStrong}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{ThemeResource TextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource TextFaint}" />
        <Setter Property="Margin" Value="14,18,0,6" />
    </Style>

    <!-- ───────────── Buttons ───────────── -->
    <!-- A flat button with a soft hover wash; the base for icon buttons, nav items and pills. -->
    <Style x:Key="SoftButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextStrong}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-2" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="Wash" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Wash.Background" Value="{ThemeResource SubtleHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Wash.Background" Value="{ThemeResource SubtlePressed}" />
                                        <Setter Target="Content.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.35" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <Style x:Key="NavButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Foreground" Value="{ThemeResource TextMuted}" />
    </Style>

    <!-- The round play button: brand gradient, white glyph. -->
    <Style x:Key="BigPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource BrandGradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <!-- Action buttons all share Shuffle's shape: 36px tall with fully rounded 18px ends. (Radii
         larger than half the height, such as 999, make WinUI draw stretched elliptical ends.) -->
    <Style x:Key="PillButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Primary action: inverse (white on near-black, black on light), easyui style. -->
    <Style x:Key="PillAccentButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Background" Value="{ThemeResource InverseBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource InverseText}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Main call to action (Play): same shape as Shuffle, brand gradient fill. -->
    <Style x:Key="PillBrandButtonStyle" TargetType="Button" BasedOn="{StaticResource PillButtonStyle}">
        <Setter Property="Background" Value="{StaticResource BrandGradient}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Toggle chips: filled and borderless when off, inverse pill when on. -->
    <Style x:Key="ChipToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource TextStrong}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="Wash" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" />
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Wash.Background" Value="{ThemeResource SubtleHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Wash.Background" Value="{ThemeResource SubtlePressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InverseBackground}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource InverseBackground}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InverseText}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InverseBackground}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource InverseBackground}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InverseText}" />
                                        <Setter Target="Content.Opacity" Value="0.85" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource InverseBackground}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource InverseText}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Opacity" Value="0.35" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented control item: muted text on the track; the selected one is a solid raised pill. -->
    <Style x:Key="SegmentToggleStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextMuted}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextStrong}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextStrong}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SegmentSelected}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextStrong}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SegmentSelected}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextStrong}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SegmentSelected}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource TextStrong}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon toggles in the player (lyrics / queue): brand glyph when on. -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextStrong}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="Content" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtlePressed}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource BrandGradient}" />
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource BrandGradient}" />
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleHover}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedPressed">
                                    <VisualState.Setters>
                                        <Setter Target="Content.Foreground" Value="{StaticResource BrandGradient}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded card container used for panels and settings groups. -->
    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBackground}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- List items: no system hover wash, our rows draw their own. -->
    <Style x:Key="PlainListViewItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
</ResourceDictionary>
