<Project Sdk="Microsoft.NET.Sdk">
  <!-- Console harness that runs Tapedeck's InnerTube client + parsers against the live API (signed out). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Tapedeck\Models\*.cs" Link="Shared\Models\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Tapedeck\Services\Api\*.cs" Link="Shared\Api\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Tapedeck\Services\GoogleDomains.cs" Link="Shared\GoogleDomains.cs" />
    <Compile Include="..\..\src\Tapedeck\Services\Discord\*.cs" Link="Shared\Discord\%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
